<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal SMIRNOFF force field for ethanol (CH3-CH2-OH) unit tests.
     Parameters derived from Parsley (OpenFF 1.0.0), subset for C/H/O only.
     Charges specified via LibraryCharges (sum = 0).
     Bond b1 (C-C) and b15 (C-OH) have parameterize attributes for ForceBalance. -->
<SMIRNOFF version="0.3" aromaticity_model="OEAroModel_MDL">
    <Bonds version="0.3" potential="harmonic">
        <Bond smirks="[#6X4:1]-[#6X4:2]" length="1.526 * angstrom" k="620.0 * angstrom**-2 * mole**-1 * kilocalorie" id="b1" parameterize="k, length"></Bond>
        <Bond smirks="[#6:1]-[#8:2]" length="1.410 * angstrom" k="640.0 * angstrom**-2 * mole**-1 * kilocalorie" id="b14"></Bond>
        <Bond smirks="[#6X4:1]-[#8X2H1:2]" length="1.410 * angstrom" k="640.0 * angstrom**-2 * mole**-1 * kilocalorie" id="b15" parameterize="length"></Bond>
        <Bond smirks="[#6X4:1]-[#1:2]" length="1.090 * angstrom" k="680.0 * angstrom**-2 * mole**-1 * kilocalorie" id="b83"></Bond>
        <Bond smirks="[#8:1]-[#1:2]" length="0.960 * angstrom" k="1106.0 * angstrom**-2 * mole**-1 * kilocalorie" id="b87"></Bond>
    </Bonds>
    <Angles version="0.3" potential="harmonic">
        <Angle smirks="[*:1]~[#6X4:2]-[*:3]" angle="109.5 * degree" k="100.0 * mole**-1 * radian**-2 * kilocalorie" id="a1"></Angle>
        <Angle smirks="[#1:1]-[#6X4:2]-[#1:3]" angle="109.5 * degree" k="70.0 * mole**-1 * radian**-2 * kilocalorie" id="a2"></Angle>
        <Angle smirks="[#6X4:1]-[#8X2:2]-[#1:3]" angle="108.5 * degree" k="110.0 * mole**-1 * radian**-2 * kilocalorie" id="a31"></Angle>
    </Angles>
    <ProperTorsions version="0.3" potential="k*(1+cos(periodicity*theta-phase))">
        <Proper smirks="[*:1]-[#6X4:2]-[#6X4:3]-[*:4]" periodicity1="3" k1="0.160 * mole**-1 * kilocalorie" phase1="0.0 * degree" idivf1="1" id="t142"></Proper>
        <Proper smirks="[*:1]-[#6X4:2]-[#8X2:3]-[*:4]" periodicity1="3" k1="0.383 * mole**-1 * kilocalorie" phase1="0.0 * degree" idivf1="1" id="t14"></Proper>
        <Proper smirks="[#1:1]-[#6X4:2]-[#6X4:3]-[#1:4]" periodicity1="3" k1="0.150 * mole**-1 * kilocalorie" phase1="0.0 * degree" idivf1="1" id="t141"></Proper>
        <Proper smirks="[#1:1]-[#6X4:2]-[#8X2:3]-[#1:4]" periodicity1="3" k1="0.000 * mole**-1 * kilocalorie" phase1="0.0 * degree" idivf1="1" id="t15"></Proper>
    </ProperTorsions>
    <ImproperTorsions version="0.3" potential="k*(1+cos(periodicity*theta-phase))">
    </ImproperTorsions>
    <vdW version="0.3" potential="Lennard-Jones-12-6" combining_rules="Lorentz-Berthelot" scale12="0.0" scale13="0.0" scale14="0.5" scale15="1.0" cutoff="9.0 * angstrom" switch_width="1.0 * angstrom" method="cutoff">
        <Atom smirks="[#1:1]" epsilon="0.0157 * mole**-1 * kilocalorie" id="n1" rmin_half="0.600 * angstrom"></Atom>
        <Atom smirks="[#1:1]-[#6X4]" epsilon="0.0157 * mole**-1 * kilocalorie" id="n2" rmin_half="1.487 * angstrom"></Atom>
        <Atom smirks="[#1:1]-[#8]" epsilon="0.0000 * mole**-1 * kilocalorie" id="n4" rmin_half="0.000 * angstrom"></Atom>
        <Atom smirks="[#6X4:1]" epsilon="0.1094 * mole**-1 * kilocalorie" id="n17" rmin_half="1.908 * angstrom"></Atom>
        <Atom smirks="[#8X2H1+0:1]" epsilon="0.2104 * mole**-1 * kilocalorie" id="n33" rmin_half="1.721 * angstrom"></Atom>
    </vdW>
    <Electrostatics version="0.3" scale12="0.0" scale13="0.0" scale14="0.8333333333" scale15="1.0" cutoff="9.0 * angstrom" switch_width="0.0 * angstrom" method="PME"></Electrostatics>
    <LibraryCharges version="0.3">
        <!-- Ethanol-specific charges (sum = 0.0) assigned atom-by-atom via SMIRKS.
             More specific patterns override less specific ones (SMIRNOFF hierarchy). -->
        <!-- OH hydrogen: +0.42 -->
        <LibraryCharge smirks="[#1:1]-[#8H1X2]-[#6H2X4]-[#6H3X4]" charge1="0.4200 * elementary_charge" name="ethanol-HO"></LibraryCharge>
        <!-- Methyl H: +0.06 (3 atoms) -->
        <LibraryCharge smirks="[#1:1]-[#6H3X4]-[#6H2X4]-[#8H1X2]" charge1="0.0600 * elementary_charge" name="ethanol-Hmethyl"></LibraryCharge>
        <!-- Methylene H: +0.035 (2 atoms) -->
        <LibraryCharge smirks="[#1:1]-[#6H2X4](-[#6H3X4])-[#8H1X2]" charge1="0.0350 * elementary_charge" name="ethanol-Hmethylene"></LibraryCharge>
        <!-- Methyl C: -0.18 -->
        <LibraryCharge smirks="[#6H3X4:1]-[#6H2X4]-[#8H1X2]" charge1="-0.1800 * elementary_charge" name="ethanol-Cmethyl"></LibraryCharge>
        <!-- Methylene C: +0.16 -->
        <LibraryCharge smirks="[#6H2X4:1](-[#6H3X4])-[#8H1X2]" charge1="0.1600 * elementary_charge" name="ethanol-Cmethylene"></LibraryCharge>
        <!-- Oxygen: -0.65 -->
        <LibraryCharge smirks="[#8H1X2:1](-[#6H2X4]-[#6H3X4])" charge1="-0.6500 * elementary_charge" name="ethanol-O"></LibraryCharge>
    </LibraryCharges>
</SMIRNOFF>
