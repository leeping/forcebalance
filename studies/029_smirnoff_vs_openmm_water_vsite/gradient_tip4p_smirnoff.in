$options
ffdir forcefield_tip4p
jobtype gradient
forcefield tip4p_fb.offxml
backup false
finite_difference_h 0.001
penalty_additive 1.0
normalize_weights no
constrain_charge false

priors
    /VirtualSites/VirtualSite/charge_increment2 : 0.1
/priors

$end

$target
name water
type AbInitio_SMIRNOFF
mol2 input.sdf
pdb water.pdb
weight 1.0
w_force 0.1
attenuate
energy_denom 5.0
energy_upper 20.0
$end
